{
  // Cloudflare Workers config for the OpenNext build of rainbow-www (public site).
  // Generated assets live in .open-next/ (git-ignored); produced by `npm run build:cf`.
  //
  //   npm run deploy:cf    build, then publish to rainbow.vorion.org
  //
  // The vorion.org zone lives in the same Cloudflare account as this Worker, so the
  // custom domain below attaches on deploy. Delete any existing DNS record for
  // `rainbow` (the old Vercel CNAME) first, or the deploy fails with error 100117.
  //
  // This is the PUBLIC deployment: always the seeded synthetic demo. It reads no
  // signal store and accepts no ingest, so it needs no secrets, and store
  // settings are ignored here even if present. The private live view is a
  // separate Worker: wrangler.live.jsonc (`npm run deploy:cf:live`).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rainbow-www",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "routes": [
    { "pattern": "rainbow.vorion.org", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  }
}
