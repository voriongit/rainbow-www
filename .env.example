# rainbow-www — environment
#
# One build, two deployments, chosen by RAINBOW_DEPLOYMENT:
#
#   public (default)  rainbow.vorion.org. ALWAYS the seeded synthetic demo. Reads
#                     no signal store and accepts no ingest (POST /api/signals is
#                     404). Needs nothing below; store settings are ignored even
#                     if present.
#   live              a private deployment behind Cloudflare Access. Real
#                     telemetry only, never the simulator. Needs every setting
#                     below. See README "Private live view" and wrangler.live.jsonc.
#
# Only the exact value `live` selects the live deployment. Anything else, or
# nothing, is public, so a typo can never expose real data.
RAINBOW_DEPLOYMENT=

# --- Cloudflare Access (live only) ---
# Every request except POST /api/signals must carry a valid Access token for this
# application; the app verifies it itself, so a request that reaches the Worker
# without going through Access is refused. Missing or malformed: every page 503s.
# <team>.cloudflareaccess.com
CF_ACCESS_TEAM_DOMAIN=
# The Access application's AUD tag
CF_ACCESS_AUD=

# --- Persistent signal store (Supabase, live only) ---
# Apply sql/rainbow-signals.sql to the project first (safe to re-run; it also
# upgrades a table created by an earlier version).
# The service role key is server-only and must never reach the client; the
# production RLS policy grants anon nothing at all.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Ingest auth (live only) ---
# Bearer token required by POST /api/signals, compared in constant time.
# Unset means ingest is DISABLED (503): it fails closed, never silently
# accepting and dropping signals.
RAINBOW_INGEST_TOKEN=

# --- Live memory budget (optional) ---
# A Worker isolate has 128 MB. Defaults: 50000 signals held, 10000 per agent,
# store re-read at most every 10000 ms. The page says when history is cut short.
# RAINBOW_LIVE_MAX_SIGNALS=
# RAINBOW_LIVE_AGENT_CAPACITY=
# RAINBOW_LIVE_REFRESH_MS=
